<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Win a $500 Amazon Gift Card</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Arial', sans-serif;
        }
        body {
            background-color: #f3f3f3;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .card {
            background: #fff;
            max-width: 450px;
            width: 100%;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            padding: 25px;
            text-align: center;
        }
        .header img {
            width: 140px;
            margin-bottom: 15px;
        }
        h1 {
            font-size: 22px;
            color: #111;
            margin-bottom: 10px;
        }
        p.subtitle {
            font-size: 14px;
            color: #555;
            margin-bottom: 20px;
        }
        .gift-img {
            width: 80%;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .quiz-step {
            display: none;
        }
        .quiz-step.active {
            display: block;
        }
        .question {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #232f3e;
        }
        .btn {
            display: block;
            width: 100%;
            background: #ff9900;
            color: #111;
            border: none;
            padding: 14px;
            margin: 10px 0;
            font-size: 16px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn:hover {
            background: #e68a00;
        }
        .loading {
            display: none;
            font-size: 16px;
            color: #111;
            font-weight: bold;
        }
        .timer {
            margin-top: 15px;
            font-size: 12px;
            color: #d9534f;
        }
    </style>
</head>
<body>

<div class="card">
    <div class="header">
        <!-- Amazon Logo -->
        <img src="https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg" alt="Amazon Logo">
    </div>
    
    <h1>Win a $500 Amazon Gift Card!</h1>
    <p class="subtitle">Answer 3 simple questions to check your eligibility.</p>
    
    <!-- Gift Card Graphic Placeholder -->
    <img class="gift-img" src="https://via.placeholder.com/400x250/232F3E/FF9900?text=%24500+Amazon+Gift+Card" alt="Amazon Gift Card">

    <!-- Question 1 -->
    <div class="quiz-step active" id="step1">
        <div class="question">1. How often do you shop on Amazon?</div>
        <button class="btn" onclick="nextStep(2)">Weekly</button>
        <button class="btn" onclick="nextStep(2)">Monthly</button>
        <button class="btn" onclick="nextStep(2)">Rarely</button>
    </div>

    <!-- Question 2 -->
    <div class="quiz-step" id="step2">
        <div class="question">2. What device are you using right now?</div>
        <button class="btn" onclick="nextStep(3)">Smartphone</button>
        <button class="btn" onclick="nextStep(3)">Computer/Laptop</button>
        <button class="btn" onclick="nextStep(3)">Tablet</button>
    </div>

    <!-- Question 3 -->
    <div class="quiz-step" id="step3">
        <div class="question">3. Are you a US/UK resident?</div>
        <button class="btn" onclick="processResult()">Yes</button>
        <button class="btn" onclick="processResult()">No</button>
    </div>

    <!-- Loading Screen -->
    <div class="loading" id="loading">
        <p>Checking eligibility...</p>
        <p style="font-size: 12px; color: #666; margin-top: 5px;">Validating answers with database...</p>
    </div>

    <!-- Final CTA Screen -->
    <div class="quiz-step" id="finalStep">
        <h2 style="color: #2e7d32; margin-bottom: 10px;">Congratulations! 🎉</h2>
        <p style="font-size: 14px; margin-bottom: 15px;">You are eligible for the $500 Amazon Gift Card giveaway.</p>
        
        <!-- YAHAN APNA CPA AFFILIATE LINK DALEIN -->
        <a id="cpaLink" href="https://app.trcefy.com/click?pid=2&offer_id=956&sub2=u828931&sub5=s1SUBID1HERE" target="_blank" style="text-decoration: none;">
            <button class="btn" style="background: #2e7d32; color: #fff;">CLAIM YOUR CARD NOW</button>
        </a>
    </div>

    <div class="timer">⚠️ Limited spots available. Offer expires soon!</div>
</div>

<script>
    function nextStep(step) {
        document.querySelectorAll('.quiz-step').forEach(el => el.classList.remove('active'));
        document.getElementById('step' + step).classList.add('active');
    }

    function processResult() {
        document.querySelectorAll('.quiz-step').forEach(el => el.classList.remove('active'));
        document.getElementById('loading').style.display = 'block';
        
        setTimeout(() => {
            document.getElementById('loading').style.display = 'none';
            document.getElementById('finalStep').classList.add('active');
        }, 1500); // 1.5 seconds delay to build curiosity
    }
</script>

</body>
</html>
